---
interface Props { embedded?: boolean }
const { embedded = false } = Astro.props;
---
<div class:list={['project-footer', { embedded }]} aria-label="Project navigation">
  <a class="wordmark" href="/">CHAO BIAN</a>
  <a href="/#projects">Back to all projects ↑</a>
</div>
<style>
  .project-footer{box-sizing:border-box;display:flex;justify-content:space-between;align-items:center;gap:20px;width:min(1200px,calc(100% - 96px));margin-inline:auto;padding:35px 0;border-top:1px solid #cfd3c3;font-size:12px;line-height:1.65;color:#272b26}
  .project-footer.embedded{width:100%;margin:0 0 30px;padding:0;border:0}
  a{color:inherit;text-decoration:none}a:hover{color:#6c7845}a:focus-visible{outline:3px solid #a0b16b;outline-offset:6px}.wordmark{font-size:13px;font-weight:700;letter-spacing:.12em}
  @media(max-width:900px){.project-footer{width:calc(100% - 48px)}}
  @media(max-width:600px){.project-footer{width:calc(100% - 36px)}}
  @media print{.project-footer{width:100%;padding-block:18pt}.project-footer.embedded{padding:0}}
</style>
