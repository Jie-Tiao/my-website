  .flow { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: center; padding: 28px; margin-top: 32px; background: #e8f2f5; border-radius: 12px; font-size: 15px; }
  .experiments { margin: 32px 0 48px; } .experiments article { display: grid; grid-template-columns: 40px 1fr auto; gap: 20px; padding: 26px 20px; border-top: 1px solid #d4e0e4; } .experiments p { margin: 0; }
  .success { background: #e8f2f5; border-radius: 12px; } .badge { font-size: 11px; font-weight: 700; color: #255e52; align-self: start; padding: 6px 12px; background: #d2e8e0; border-radius: 20px; }
  .vision img { background: #193b29; } .page-footer { display: flex; justify-content: space-between; gap: 20px; padding: 24px 0 40px; border-top: 1px solid #d4e0e4; font-size: 12px; }
  @media (max-width: 800px) { main { padding: 24px 24px 0; } .metadata { grid-template-columns: 1fr 1fr; } .cards, .split { grid-template-columns: 1fr; } .experiments article { grid-template-columns: 30px 1fr; } .badge { grid-column: 2; } section { padding: 44px 0; } .hero { padding: 48px 0 36px; } }
  @media (max-width: 480px) { main { padding-inline: 20px; } .lead, .intro { font-size: 18px; } .page-footer { flex-direction: column; } .flow { gap: 10px; padding: 20px; } }
</style>
