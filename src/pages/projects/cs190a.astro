  .metadata div { display: flex; flex-direction: column; gap: 8px; } .metadata strong { font-size: 14px; font-weight: 500; }
  nav { display: flex; flex-wrap: wrap; gap: 20px 28px; margin-top: 28px; font-size: 14px; font-weight: 700; } nav a { text-decoration: none; }
  figure { margin: 0; min-width: 0; } figure img { display: block; width: 100%; height: auto; border-radius: 12px; }
  .cover { margin-bottom: 60px; } .cover img { max-height: 680px; object-fit: contain; background: #193b29; }
  figcaption { font-size: 12px; color: #647881; line-height: 1.6; margin-top: 12px; }
