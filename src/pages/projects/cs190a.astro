  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 32px 0; }
  .cards article { padding: 26px; border: 1px solid #d4e0e4; border-radius: 12px; background: #f7fafb; } .cards p { margin-bottom: 0; font-size: 15px; }
  .note { font-size: 13px; color: #647881; } .split { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
