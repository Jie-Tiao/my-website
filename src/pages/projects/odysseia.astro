  }
  @media (max-width: 480px) {
    main { padding: 24px 20px 0; }
    .lead { font-size: 18px; }
    .two-image-grid, .technical-grid, .contributions ul { grid-template-columns: 1fr; }
    .contributions, .technical-grid article { padding: 24px 20px; }
    .progression { grid-template-columns: 1fr; }
    .step-number { margin-bottom: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
