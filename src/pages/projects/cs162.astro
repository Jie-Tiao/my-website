background:#e9eddf;border-radius:12px;margin:30px 0;font-size:13px}.flow b{color:#7c9364;font-weight:400}.example{display:grid;grid-template-columns:1fr 1.1fr;border:1px solid #cbd3c3;border-radius:14px;overflow:hidden;margin:35px 0}.expression{padding:35px;background:#25382a;color:#f0f3e8}.expression .eyebrow{color:#b7cca2}pre{font-size:clamp(18px,2.5vw,26px);white-space:pre-wrap;overflow-wrap:anywhere;margin:35px 0 45px}.result{border-top:1px solid #52654f;padding-top:20px;display:flex;justify-content:space-between;align-items:center}.result span{font-size:12px;color:#c0cdb7}.result strong{font-size:28px;font-weight:500}.example ol{margin:0;padding:30px 30px 20px 55px}.example li{padding-left:7px;margin-bottom:22px}.example li::marker{color:#63824a;font-size:13px}.example h3{font-size:15px;margin-bottom:6px}.example li p{font-size:14px;margin:0}.reflection{max-width:800px;border:0;padding-bottom:55px}.reflection p{font-size:16px}footer{display:flex;justify-content:space-between;gap:20px;padding:24px 0 40px;border-top:1px solid #d4d9ce;font-size:12px;color:#64715e}
