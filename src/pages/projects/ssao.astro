n:24px 0 0}.dark{background:#272e24;color:#fffef8}.dark h2,.dark h3{color:#fffef8}.dark p{color:#e1e6d8}.dark .eyebrow,.pipeline span{color:#c9d7af}.pipeline{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;padding:0;margin:38px 0;border-block:1px solid #525c46}.pipeline li{padding:25px 22px;border-right:1px solid #525c46}.pipeline li:first-child{padding-left:0}.pipeline li:last-child{border-right:0}.pipeline h3{margin:16px 0 12px}.pipeline p{font-size:14px;margin:0}.pipeline span{font:12px monospace}.filter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:35px}.filter-grid figure{display:flex;flex-direction:column}.filter-grid h3{font-size:19px}.crop{display:block;position:relative;aspect-ratio:3/4;flex-shrink:0;overflow:hidden;background:white}.crop img{position:absolute;width:480%;max-width:none;height:auto;left:-75%;top:-65.625%;border-radius:0}.filter-grid figcaption{display:flex;flex-direction:column;flex:1;font-size:13px;color:#626a58;margin-top:18px}.filter-grid figcaption a{display:block;margin-top:auto;padding-top:12px}.tinted{background:#e8ebdf}.debugging-copy{max-width:800px}.capture-settings{font-size:12px;line-height:1.8;letter-spacing:normal;color:#414e34;border-top:1px solid #cfd3c3;padding-top:18px;margin:24px 0 6px}.environment{font-size:12px;margin:0;color:#626a58}.takeaway{font-size:26px;line-height:1.5;max-width:850px;margin:28px 0;color:#414e34}.credits{padding-block:40px}.credits p,.credits>a{font-size:12px}.skip{position:absolute;left:20px;top:-100px;background:white;padding:10px;z-index:5}.skip:focus{top:10px}
  @media(max-width:900px){.wrap{width:calc(100% - 48px)}.pipeline{grid-template-columns:1fr 1fr}.pipeline li:first-child{padding-left:22px}.pipeline li:nth-child(2){border-right:0}.filter-grid{gap:16px}}
  @media(max-width:600px){.wrap{width:calc(100% - 36px)}.hero{padding-top:30px}.chapter{padding-block:45px}dl,.filter-grid,.pipeline{grid-template-columns:1fr}.intro{font-size:18px}.filter-grid{gap:30px}.filter-grid figure{width:100%;max-width:400px;margin:auto}.pipeline li,.pipeline li:first-child{padding:20px 0;border-right:0;border-bottom:1px solid #525c46}.pipeline li:last-child{border-bottom:0}.tag{font-size:10px;top:8px}.left{left:8px}.right{right:8px}.takeaway{font-size:23px}}
  @media print{.dark{background:#fff;color:#20251c}.dark h2,.dark h3{color:#20251c}.dark p,.dark .eyebrow,.pipeline span{color:#37402e}.pipeline{border-color:#9ba58d}.pipeline li{border-color:#9ba58d}.skip,input,.result figcaption{display:none}.chapter{padding-block:30px}.wrap{width:100%}figure{break-inside:avoid}}
</style>
