---
import BaseHead from '../../components/BaseHead.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import ProjectFooter from '../../components/ProjectFooter.astro';
const filters = [
  { file: 'raw_ao', title: 'Raw AO', note: 'Visible sampling noise.' },
  { file: 'gaussian', title: 'Gaussian', note: 'Smoother, but the mirror silhouette becomes blurred.' },
  { file: 'guided', title: 'Normal + depth guided', note: 'Reduces noise while keeping the mirror frame more distinct.' },
];
const stages = [
  ['01', 'Input / reconstruct', 'Reconstruct world-space positions from camera depth using the inverse view-projection matrix, and read normals in world space.', ''],
  ['02', 'Occlusion estimation', 'Orient hemisphere samples around the surface normal and project them into screen space. Compare sample depths with the scene depth to estimate occlusion.', 'raw_ao'],
  ['03', 'Guided filtering', 'Smooth raw AO with horizontal and vertical 7-tap passes, using normal and depth differences to reduce blending across surface boundaries.', 'guided'],
  ['04', 'Composition', 'Apply filtered visibility to the rendered scene. Separate raw and filtered AO outputs support debugging and comparison.', 'composite'],
];
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Screen-Space Ambient Occlusion — Chao Bian" description="A Unity SSAO implementation study: depth reconstruction, hemisphere sampling, and normal and depth guided filtering with visual comparisons." /></head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <ProjectHeader />
    <main id="main">
      <header class="wrap hero">
        <p class="eyebrow">COMPUTER GRAPHICS / UNITY BUILT-IN · HLSL / CG</p>
        <h1>Screen-Space<br />Ambient Occlusion<span>From noisy samples to clearer contact.</span></h1>
        <p class="intro">A rendering study in reconstructing scene geometry, estimating local occlusion, and preserving surface boundaries during filtering.</p>
        <dl><div><dt>MY WORK</dt><dd>SSAO implementation &amp; debugging</dd></div><div><dt>FOCUS</dt><dd>Depth, normals &amp; multi-pass filtering</dd></div><div><dt>PROJECT TYPE</dt><dd>Implementation study</dd></div><div><dt>ENGINE</dt><dd>Unity 2022.3 · Built-in · Deferred</dd></div></dl>
      </header>

      <nav class="chapter-nav" aria-label="Project sections"><div class="wrap"><a href="#result">01 / Final result</a><a href="#implementation">02 / Implementation</a><a href="#filtering">03 / Filtering study</a><a href="#debugging">04 / Debugging &amp; takeaways</a></div></nav>

      <section id="result" class="wrap chapter">
        <p class="eyebrow">01 / FINAL RESULT</p>
        <h2>Grounding the scene.</h2>
        <p class="intro">Occlusion strengthens the contact beneath the bed and chair, along wall corners, and where the ceiling beams meet. Compare the same camera view with and without the effect.</p>
        <figure class="result" style="--split:50%">
          <div class="image-stack">
            <img src="/projects/ssao/no_ao.webp" width="1920" height="1080" alt="Cabin interior without the custom SSAO effect" />
            <img class="with-ao" src="/projects/ssao/composite.webp" width="1920" height="1080" alt="Same cabin interior with guided SSAO applied" />
            <span class="tag left">With SSAO</span><span class="tag right">No AO</span><span class="divider" aria-hidden="true">↔</span>
          </div>
          <figcaption><label for="ao-split">Slide to compare</label><output for="ao-split">50% with SSAO</output></figcaption>
          <input id="ao-split" type="range" min="0" max="100" value="50" aria-label="Percentage of the image showing SSAO" />
        </figure>
        <p class="note">This is a post-process approximation: visibility modulates the full rendered image, including direct lighting and highlights, rather than only an isolated ambient-light term.</p>
      </section>

      <section id="implementation" class="dark"><div class="wrap chapter">
        <p class="eyebrow">02 / IMPLEMENTATION</p><h2>Depth to visibility.</h2>
        <ol class="pipeline" aria-label="SSAO rendering pipeline">{stages.map(([number, title, text, image]) => <li>
          <span class="stage-number">{number}</span><h3>{title}</h3>
          <div class="stage-media">{image ? <a class="stage-image" href={`/projects/ssao/${image}.webp`} aria-label={`View full ${title} image`}><img src={`/projects/ssao/${image}.webp`} width="1920" height="1080" alt={title === 'Composition' ? 'Cabin scene with SSAO composited onto scene color' : `${title} output in the cabin scene`} loading="lazy" /></a> : <div class="input-buffers">{["depth", "normals"].map(buffer => <a href={`/projects/ssao/${buffer}.webp`} aria-label={`View full ${buffer} capture`}><img src={`/projects/ssao/${buffer}.webp`} width="1920" height="1080" loading="lazy" alt={buffer === "depth" ? "Captured depth visualization of the cabin scene" : "Captured normal visualization of the cabin scene"} /><span>{buffer === "depth" ? "Depth" : "Normals"}</span></a>)}</div>}</div>
          <p>{text}</p>
        </li>)}</ol>
        <p class="note">The occlusion pass rejects background and off-screen samples, applies a depth bias, and attenuates contributions across large depth differences. Material and temporary render texture lifetimes are managed in the C# camera component.</p>
      </div></section>

      <section id="filtering" class="wrap chapter">
        <p class="eyebrow">03 / FILTERING STUDY</p><h2>Smoothing noise.<br />Keeping the boundary.</h2>
        <p class="intro">Gaussian filtering blends nearby pixels based only on screen-space distance. Normal and depth guidance reduces the weights of samples from different surfaces, smoothing noise while better preserving boundaries such as the mirror frame.</p>
        <div class="filter-grid">{filters.map(({file, title, note}) => <figure><h3>{title}</h3><a class="crop" href={`/projects/ssao/${file}.webp`} aria-label={`Open full-resolution ${title} image`}><img src={`/projects/ssao/${file}.webp`} width="1920" height="1080" loading="lazy" alt={`${title}: close-up of the standing mirror and adjacent wall`} /></a><figcaption>{note}<a href={`/projects/ssao/${file}.webp`}>View full image ↗</a></figcaption></figure>)}</div>
        <p class="capture-settings">30 samples · Full resolution · 7 taps/pass · 2 px spacing</p>
        <p class="environment">Capture environment: Unity 2022.3.36f1 · Built-in Render Pipeline · Deferred rendering</p>
        <p class="note">All three crops show the same region at the same scale. Guidance improves edge preservation, while residual grain and low-frequency patches remain visible on broad surfaces.</p>
      </section>

      <section id="debugging" class="tinted"><div class="wrap chapter">
        <p class="eyebrow">04 / DEBUGGING &amp; TAKEAWAYS</p><h2>The filter footprint matters.</h2>
        <div class="debugging-copy"><h3>Matching horizontal and vertical sampling</h3><p>The earlier pipeline filtered into a half-resolution texture before the vertical pass. Using that texture’s texel size doubled the vertical sample spacing relative to the horizontal pass.</p><p>I changed both intermediate textures to full resolution, giving the two directions a consistent pixel footprint.</p></div>
        <p class="takeaway">Building this effect connected depth reconstruction, hemisphere sampling, and filtering into a working screen-space pipeline. Comparing Gaussian and geometry-guided filtering helped me understand how smoothing changes both noise and surface boundaries.</p>
      </div></section>

      <footer class="wrap credits">
        <p class="eyebrow">REFERENCES &amp; ASSET CREDITS</p>
        <p>Technical reference: <a href="https://learnopengl.com/Advanced-Lighting/SSAO">LearnOpenGL — SSAO</a>, covering normal-oriented hemisphere sampling, screen-space depth comparisons, and noise reduction.</p>
        <p>Environment: <a href="https://assetstore.unity.com/packages/3d/environments/urban/furnished-cabin-71426">Furnished Cabin by Johnny Kasapi</a>, used for rendering evaluation. My work covers the SSAO shaders, filtering, and camera-side integration.</p>
        <p>Scope: screen-space occlusion and spatial filtering. Geometry off-screen or hidden behind visible surfaces is unavailable in the current depth buffer, no temporal accumulation is implemented, and these captures are visual comparisons rather than GPU performance measurements.</p>
      </footer>
    </main>
    <ProjectFooter />
  </body>
</html>
<script>
  const slider = document.querySelector<HTMLInputElement>('#ao-split');
  const figure = document.querySelector<HTMLElement>('.result');
  const output = figure?.querySelector('output');
  slider?.addEventListener('input', () => {
    figure?.style.setProperty('--split', `${slider.value}%`);
    if (output) output.value = `${slider.value}% with SSAO`;
  });
</script>
<style>
  :global(body){background:#f4f3eb;color:#30362a;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.7}main{width:100%;max-width:none;margin:0;padding:0}.wrap{width:min(1200px,calc(100% - 96px));margin-inline:auto}h1,h2,h3{color:inherit;font-weight:500}h1,h2{letter-spacing:-.055em}h1{font-size:clamp(54px,7.5vw,100px);line-height:1;margin:32px 0}h1 span{display:block;font-size:clamp(22px,3vw,36px);color:#7a865f;letter-spacing:-.03em;margin-top:24px}h2{font-size:clamp(36px,5vw,62px);line-height:1.06;margin:0 0 28px}h3{font-size:22px;letter-spacing:-.025em}p{color:#626a58;margin:0 0 20px}.eyebrow,dt{font:10px/1.7 monospace;letter-spacing:.1em;color:#6e7b57}.intro{max-width:790px;font-size:20px;line-height:1.6}.hero{padding-block:50px 35px}.chapter{padding-block:65px}.links{display:flex;flex-wrap:wrap;gap:14px;font-size:13px}.button{display:inline-flex;justify-content:space-between;gap:30px;background:#30392a;color:#f4f3eb;padding:15px 22px;font-size:12px;text-decoration:none;white-space:nowrap}.button:hover{background:#52603d;color:white}dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin:35px 0 25px;padding-block:22px;border-block:1px solid #cfd3c3}dd{margin:6px 0 0;font-size:13px}figure{margin:0;min-width:0}a{color:inherit;text-underline-offset:4px}a:hover{color:#6e7b49}a:focus-visible,input:focus-visible{outline:3px solid #71884c;outline-offset:5px}.image-stack{position:relative;aspect-ratio:16/9;overflow:hidden;background:#25271f}.image-stack img{display:block;position:absolute;inset:0;width:100%;height:100%;border-radius:0}.with-ao{clip-path:inset(0 calc(100% - var(--split)) 0 0)}.tag{position:absolute;top:16px;padding:5px 10px;background:#20271de8;color:white;font-size:12px}.left{left:16px}.right{right:16px}.divider{position:absolute;left:var(--split);top:0;bottom:0;width:2px;background:white;display:flex;align-items:center;justify-content:center;color:white;text-shadow:0 1px 3px black;pointer-events:none}.result figcaption{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-top:14px}input{display:block;width:100%;margin:8px 0 0;min-height:30px;accent-color:#62754a;cursor:ew-resize}.note{font-size:13px;max-width:900px;margin:24px 0 0}.dark{background:#272e24;color:#fffef8}.dark h2,.dark h3{color:#fffef8}.dark p{color:#e1e6d8}.dark .eyebrow,.pipeline span{color:#c9d7af}.pipeline{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;padding:0;margin:38px 0;border-block:1px solid #525c46}.pipeline li{padding:25px 22px;border-right:1px solid #525c46}.pipeline li:first-child{padding-left:0}.pipeline li:last-child{border-right:0}.pipeline h3{margin:16px 0 12px}.pipeline p{font-size:14px;margin:0}.pipeline span{font:12px monospace}.filter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:35px}.filter-grid figure{display:flex;flex-direction:column}.filter-grid h3{font-size:19px}.crop{display:block;position:relative;aspect-ratio:3/4;flex-shrink:0;overflow:hidden;background:white}.crop img{position:absolute;width:480%;max-width:none;height:auto;left:-75%;top:-65.625%;border-radius:0}.filter-grid figcaption{display:flex;flex-direction:column;flex:1;font-size:13px;color:#626a58;margin-top:18px}.filter-grid figcaption a{display:block;margin-top:auto;padding-top:12px}.tinted{background:#e8ebdf}.debugging-copy{max-width:800px}.capture-settings{font-size:12px;line-height:1.8;letter-spacing:normal;color:#414e34;border-top:1px solid #cfd3c3;padding-top:18px;margin:24px 0 6px}.environment{font-size:12px;margin:0;color:#626a58}.takeaway{font-size:26px;line-height:1.5;max-width:850px;margin:28px 0;color:#414e34}.credits{border-top:1px solid #cfd3c3;padding-block:35px}.credits p{font-size:11px;line-height:1.9;margin:0;max-width:none}.credits .eyebrow{font-family:monospace;font-size:11px;line-height:1.9;letter-spacing:.09em;margin:0 0 25px}.credits p a{color:#536b36;font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}.credits p a:hover{color:#30461f;text-decoration-thickness:2px}.skip{position:absolute;left:20px;top:-100px;background:white;padding:10px;z-index:5}.skip:focus{top:10px}
  @media(max-width:900px){dl{grid-template-columns:1fr 1fr}.wrap{width:calc(100% - 48px)}.pipeline{grid-template-columns:1fr 1fr}.pipeline li:first-child{padding-left:22px}.pipeline li:nth-child(2){border-right:0}.filter-grid{gap:16px}}
  @media(max-width:600px){.wrap{width:calc(100% - 36px)}.hero{padding-top:30px}.chapter{padding-block:45px}dl,.filter-grid,.pipeline{grid-template-columns:1fr}.intro{font-size:18px}.filter-grid{gap:30px}.filter-grid figure{width:100%;max-width:400px;margin:auto}.pipeline li,.pipeline li:first-child{padding:20px 0;border-right:0;border-bottom:1px solid #525c46}.pipeline li:last-child{border-bottom:0}.tag{font-size:10px;top:8px}.left{left:8px}.right{right:8px}.takeaway{font-size:23px}}
  @media print{.dark{background:#fff;color:#20251c}.dark h2,.dark h3{color:#20251c}.dark p,.dark .eyebrow,.pipeline span{color:#37402e}.pipeline{border-color:#9ba58d}.pipeline li{border-color:#9ba58d}.skip,input,.result figcaption{display:none}.chapter{padding-block:30px}.wrap{width:100%}figure{break-inside:avoid}}
.chapter-nav{border-block:1px solid #cfd3c3}.chapter-nav>div{display:flex;gap:35px;padding-block:18px;overflow-x:auto}.chapter-nav a{white-space:nowrap;font-size:11px;text-decoration:none}.chapter{scroll-margin-top:24px}.pipeline{gap:28px;border:0}.pipeline li,.pipeline li:first-child{position:relative;min-width:0;padding:0;border:0}.pipeline li:not(:last-child)::after{content:"→";position:absolute;right:-24px;top:150px;color:#c9d7af;font-size:22px}.pipeline h3{font-size:18px;min-height:44px;margin:12px 0 16px}.stage-image,.input-diagram{display:block;aspect-ratio:16/9;position:relative;overflow:hidden;background:#1a2118;margin-bottom:18px}.stage-image img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0}.input-diagram svg{display:block;width:100%;height:100%}.input-diagram>div{position:absolute;inset:0 0 auto;display:grid;grid-template-columns:1fr 1fr;text-align:center;background:#192017d9}.input-diagram span{font:10px/1.8 Arial,sans-serif;color:white}.input-diagram small{position:absolute;bottom:4px;left:50%;transform:translateX(-50%);white-space:nowrap;background:#192017e8;color:white;font-size:9px;padding:1px 5px}@media(max-width:900px){.pipeline li:nth-child(2)::after{display:none}}@media(max-width:600px){.pipeline{gap:40px}.pipeline li,.pipeline li:first-child{padding:0;border:0}.pipeline h3{min-height:0}.pipeline li:not(:last-child)::after{content:"↓";display:block;top:auto;bottom:-35px;right:50%;font-size:22px}.chapter-nav>div{gap:24px}}@media print{.chapter-nav{display:none}.pipeline li{break-inside:avoid}.pipeline li::after{display:none!important}}
.input-buffers{display:grid;grid-template-columns:1fr 1fr;gap:4px;aspect-ratio:16/9;margin-bottom:18px;background:#1a2118}.input-buffers a{position:relative;min-width:0;overflow:hidden;display:block}.input-buffers img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0}.input-buffers span{position:absolute;left:0;right:0;top:0;text-align:center;background:#192017e8;color:white;font:10px/1.8 Arial,sans-serif}
.pipeline li::after{display:none!important}.stage-media{position:relative;margin-bottom:18px}.stage-media .stage-image,.stage-media .input-buffers{margin-bottom:0}.pipeline li:not(:last-child) .stage-media::after{content:"→";position:absolute;right:-24px;top:50%;transform:translateY(-50%);color:#c9d7af;font-size:22px;line-height:1;pointer-events:none}@media(min-width:601px) and (max-width:900px){.pipeline li:nth-child(2) .stage-media::after{content:"↓";right:50%;top:auto;bottom:-24px;transform:none}.pipeline{row-gap:38px}}@media(max-width:600px){.pipeline li .stage-media::after{display:none}.pipeline li:not(:last-child)::after{display:block!important}}@media print{.pipeline li::after,.stage-media::after{display:none!important}}
</style>
