---
import BaseHead from '../components/BaseHead.astro';
import BrandMark from '../components/BrandMark.astro';
const selected = [
  { slug: 'odysseia', name: 'Odysseia', image: 'odysseia/cover.webp', alt: 'Odysseia artwork: a galley sailing through a rocky sea channel', focus: 'Connected gameplay systems', description: 'Designing and implementing tides, light puzzles, and interconnected gameplay systems in an ongoing team adventure.', role: 'Puzzle Lead / Gameplay Programmer · Team Project', tags: ['Unity / C#', 'Puzzle Systems', 'Level Design'] },
  { slug: 'path-tracer', name: 'CPU Path Tracer', image: 'path-tracer/microfacet.png', alt: 'Rendered metal and plastic spheres with varying surface roughness', focus: 'Rendering & performance', description: 'Extending a tutorial-based C++ renderer, then comparing sampling quality, acceleration, and multithreaded performance.', role: 'Individual Developer · Personal Graphics Study', tags: ['GGX Sampling', 'SAH BVH', 'C++'] },
  { slug: 'echoes-of-time', name: 'Echoes of Time', image: 'echoes-of-time/cover-logo.webp', alt: 'Echoes of Time title in a pixel-art stone courtyard', focus: 'Mechanic exploration', description: 'Rewind time and replay past actions as physical echoes, turning one player’s movements into spatial puzzles.', role: 'Solo Developer · 2-day Game Jam', tags: ['Time Rewind', 'Action Replay', 'Puzzle Design'] },
  { slug: 'shadow-runner', name: 'Shadow Runner', image: 'shadow-runner/trailer-poster.webp', alt: 'Shadow Runner split-screen worlds controlled by a shared input', focus: 'Prototype to release', description: 'One input controls two characters across different worlds. Built from prototype to release, refined through playtesting.', role: 'Solo Developer · Released Course Project', tags: ['Unity / C#', 'Shared Controls', 'Playtest Iteration'] },
];
const groups = [
  { title: 'Graphics Studies', note: 'Light, materials & screen space', projects: [
    { slug: 'pbr-shader', name: 'Unity PBR Shader', image: 'pbr-shader/custom-bronze-combined.png', alt: 'Bronze helmet rendered with a custom PBR shader', description: 'Microfacet shading and environment lighting.', context: 'Individual Study · Unity / HLSL' },
    { slug: 'ssao', name: 'SSAO', image: 'ssao/composite.webp', alt: 'Cabin scene with screen-space ambient occlusion', description: 'Depth reconstruction and guided AO filtering.', context: 'Individual Study · Unity / HLSL' },
  ] },
  { title: 'More Games', note: 'Small worlds, shared ideas', projects: [
    { slug: 'ink-pool', name: 'Strange Tales of the Ink Pool', image: 'ink-pool/cover.webp', alt: 'Ink-wash landscape and title artwork', description: 'Card-driven storytelling in an ink-wash world.', context: 'Gameplay Programmer · 48-hour Team Jam' },
    { slug: 'snowbound', name: 'Snowbound', image: 'snowbound/cover.webp', alt: 'Two characters in a snowy cooperative platformer', description: 'Snowballs, freezing, and two-player cooperation.', context: 'Gameplay Programmer · 48-hour Team Jam' },
  ] },
  { title: 'Other Technical Projects', note: 'Learning agents & language tools', projects: [
    { slug: 'cs190a', name: 'PPO Autonomous Racing', image: 'cs190a/cover.webp', alt: 'Autonomous racing track and trajectory illustration', description: 'A Unity environment for reward design and control.', context: 'Environment & Rewards · Team Course Project' },
    { slug: 'cs162', name: 'λ⁺ Interpreter & Type Inference', image: 'cs162/cover.svg', alt: 'Identity function syntax tree and inferred type', description: 'Evaluation, type checking, and unification.', context: 'Course Project · OCaml' },
  ] },
];
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Chao Bian — Games & Graphics" description="Gameplay systems, rendering experiments, and games by Chao Bian. Selected work in Unity, C++, and interactive worlds." /></head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Chao Bian home"><BrandMark /> CHAO BIAN</a>
      <nav aria-label="Main navigation"><a href="#projects">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
    </header>
    <main id="main" class="wrap">
      <section class="hero" aria-labelledby="intro-title">
        <div><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> GAME DEVELOPMENT / COMPUTER GRAPHICS</p>
        <h1 id="intro-title">Chao Bian<span>Building systems.<br />Creating play.</span></h1></div>
        <div class="hero-aside"><p>I build gameplay systems, explore rendering, and turn small rules into interactive worlds.</p><a class="text-link" href="#projects">Explore selected work <span aria-hidden="true">↘</span></a><div class="contact-links"><a href="/Chao_Bian_CV.pdf" target="_blank" rel="noopener noreferrer">CV (PDF) ↗</a><a href="mailto:chaobian3@gmail.com">Email ↗</a></div></div>
        <div class="hero-bottom"><span>GAMEPLAY · RENDERING · INTERACTION</span><span>PORTFOLIO / 10 PROJECTS</span></div>
      </section>
      <section id="projects" class="selected" aria-labelledby="selected-title">
        <div class="section-heading"><div><p class="eyebrow">01 / FEATURED WORK</p><h2 id="selected-title">Selected Projects<span class="count">04</span></h2></div><p>Four perspectives on how I build.</p></div>
        <div class="selected-grid">
          {selected.map((project, index) => <a class="project-card" href={`/projects/${project.slug}`}>
            <div class:list={['project-image', project.slug]}><img src={`/projects/${project.image}`} alt={project.alt} width="960" height="540" loading={index < 2 ? 'eager' : 'lazy'} /><span class="image-index">0{index + 1} / {project.focus}</span><span class="image-arrow" aria-hidden="true">↗</span></div>
            <div class="project-content"><h3>{project.name}</h3><p class="description">{project.description}</p><p class="role">{project.role}</p><ul class="tags" aria-label="Technical focus">{project.tags.map(tag => <li>{tag}</li>)}</ul></div>
          </a>)}
        </div>
      </section>
      <section id="more" class="more" aria-labelledby="more-title">
        <div class="section-heading"><div><p class="eyebrow">02 / CONTINUE EXPLORING</p><h2 id="more-title">More Projects<span class="count">06</span></h2></div><p>Studies and experiments, by direction.</p></div>
        {groups.map(group => <div class="project-group"><div class="group-heading"><h3>{group.title}</h3><p>{group.note}</p></div><div class="compact-grid">{group.projects.map(project => <a class="compact-card" href={`/projects/${project.slug}`}><div class="compact-image"><img src={`/projects/${project.image}`} alt={project.alt} width="400" height="225" loading="lazy" /></div><div><h4>{project.name}<span aria-hidden="true">↗</span></h4><p>{project.description}</p><span class="context">{project.context}</span></div></a>)}</div></div>)}
      </section>
      <section id="about" class="about" aria-labelledby="about-title"><div><p class="eyebrow">03 / BEHIND THE WORK</p><h2 id="about-title">From how it looks<br />to how it plays.</h2></div><div class="about-copy"><p>I’m interested in how interactive worlds are built: the systems behind a puzzle, the light on a material, and the feedback that makes a game feel right.</p><p>My work spans team game development, independent games, and graphics studies. I’m preparing for graduate study in computer graphics and game development.</p><div id="contact" class="contact-block"><p class="eyebrow">GET IN TOUCH</p><a class="email-link" href="mailto:chaobian3@gmail.com">chaobian3@gmail.com ↗</a><div class="contact-links"><a href="/Chao_Bian_CV.pdf" target="_blank" rel="noopener noreferrer">View CV (PDF) ↗</a><a href="/Chao_Bian_CV.pdf" download>Download CV ↓</a></div></div></div></section>
    </main>
    <footer class="wrap"><a class="wordmark" href="/">CHAO BIAN</a><p>Games, graphics, and the systems between them.</p><span>© {new Date().getFullYear()}</span></footer>
  </body>
</html>
<style>
  :global(html){scroll-behavior:smooth;scroll-padding-top:24px;color-scheme:dark}
  :global(body){margin:0;background:#111719;color:#ebeeea;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6}
  :global(*){box-sizing:border-box} .wrap{width:min(1200px,calc(100% - 96px));margin-inline:auto}main{max-width:none;padding:0}a{color:inherit;text-decoration:none}h1,h2,h3,h4,p{margin:0;color:inherit}a:focus-visible{outline:2px solid #a5dac5;outline-offset:6px}.skip{position:absolute;top:-100px;left:20px;padding:12px;background:#a5dac5;color:#111719;z-index:20}.skip:focus{top:12px}
  .site-header{display:flex;align-items:center;justify-content:space-between;padding-block:24px;border-bottom:1px solid #34403f}.wordmark{display:flex;align-items:center;gap:14px;font:700 11px/1.5 Arial,sans-serif;letter-spacing:.12em}nav{display:flex;gap:32px;font-size:12px;color:#b3bfbb}nav a:hover,.text-link:hover{color:#a5dac5}
  .hero{position:relative;display:grid;grid-template-columns:1.5fr 1fr;column-gap:80px;align-items:end;padding:56px 0 0;background-image:linear-gradient(#8ab8a308 1px,transparent 1px),linear-gradient(90deg,#8ab8a308 1px,transparent 1px);background-size:64px 64px}.eyebrow{font:10px/1.7 Consolas,monospace;letter-spacing:.13em;color:#a5dac5}.status-dot{display:inline-block;width:6px;height:6px;background:#a5dac5;border-radius:50%;margin-right:8px}h1{font-size:clamp(52px,6.4vw,84px);line-height:1.02;letter-spacing:-.065em;font-weight:500;margin-top:20px}h1>span{display:block;font-size:.55em;letter-spacing:-.045em;color:#9eaaa4;line-height:1.12;margin-top:14px}.hero-aside{padding-bottom:7px;max-width:330px}.hero-aside p{font-size:18px;color:#bdc7c2;line-height:1.65}.text-link{display:inline-flex;gap:30px;font-size:12px;border-bottom:1px solid #637a70;padding-bottom:6px;margin-top:25px}.text-link span{color:#a5dac5}.hero-bottom{grid-column:1/-1;display:flex;justify-content:space-between;border-top:1px solid #34403f;padding:15px 0;margin-top:40px;font:9px/1.5 Consolas,monospace;letter-spacing:.12em;color:#8b9b94}
  .contact-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:16px;font-size:12px;color:#bdd5c7}.contact-links a:hover,.email-link:hover{color:#a5dac5;text-decoration:underline;text-underline-offset:4px}.contact-block{border-top:1px solid #34403f;padding-top:22px;margin-top:26px}.contact-block .eyebrow{font-size:10px;color:#a5dac5;margin-bottom:10px}.email-link{font-size:clamp(16px,2vw,22px);overflow-wrap:anywhere} .selected{padding:34px 0 70px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:28px}.section-heading .eyebrow{margin-bottom:10px}h2{font-size:clamp(28px,3vw,40px);font-weight:500;letter-spacing:-.045em;line-height:1.15}.count{display:inline-block;vertical-align:top;font:10px/1.5 Consolas,monospace;color:#a5dac5;margin:3px 0 0 12px;letter-spacing:0}.section-heading>p{font-size:12px;color:#98a79f}.selected-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 28px}.project-card{min-width:0;border:1px solid #34403f;background:#171e20;transition:border-color .2s}.project-card:hover{border-color:#8aa99b}.project-image{position:relative;aspect-ratio:16/9;overflow:hidden;background:#242c2c}.project-image img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0;transition:transform .35s}.project-card:hover img{transform:scale(1.025)}.path-tracer img{object-fit:contain;background:#080a09}.image-index{position:absolute;left:14px;bottom:14px;background:#111719e8;padding:5px 9px;font:9px/1.5 Consolas,monospace;letter-spacing:.03em;color:#dce8df}.image-arrow{position:absolute;right:14px;top:14px;display:grid;place-items:center;width:30px;height:30px;background:#111719df;color:#d0e5d8}.project-content{padding:23px 24px 24px}h3{font-size:25px;line-height:1.2;font-weight:500;letter-spacing:-.035em}.description{font-size:14px;line-height:1.65;color:#b3c0b9;margin-top:12px;min-height:70px}.role{font-size:11px;color:#92a49a;margin-top:16px}.tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:17px 0 0}.tags li{border:1px solid #3a4943;padding:4px 8px;font:10px/1.5 Consolas,monospace;color:#bdd5c7}
  .more{border-top:1px solid #34403f;padding:48px 0 64px}.project-group{margin-top:30px}.group-heading{display:flex;align-items:baseline;gap:18px;margin-bottom:16px}.group-heading h3{font-size:17px;letter-spacing:-.02em}.group-heading p{font:10px/1.5 Consolas,monospace;color:#8a9d92}.compact-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}.compact-card{display:grid;grid-template-columns:128px minmax(0,1fr);gap:18px;align-items:center;padding-block:16px;border-block:1px solid #34403f}.compact-image{aspect-ratio:4/3;overflow:hidden;background:#252e29}.compact-image img{display:block;width:100%;height:100%;object-fit:cover;border-radius:0;transition:opacity .2s}.compact-card:hover img{opacity:.75}h4{display:flex;justify-content:space-between;gap:10px;font-size:16px;font-weight:500;line-height:1.3;letter-spacing:-.025em}h4 span{color:#a5dac5}.compact-card p{font-size:12px;color:#b3c0b9;margin-top:8px}.context{display:block;font-size:10px;color:#8fa296;margin-top:10px}
  .about{display:grid;grid-template-columns:1fr 1fr;gap:70px;border-top:1px solid #34403f;padding:60px 0 70px}.about h2{font-size:42px;margin-top:22px}.about-copy p{font-size:15px;color:#b3c0b9;margin-bottom:18px}.about-copy .text-link{margin-top:6px}footer{display:flex;justify-content:space-between;gap:20px;align-items:center;border-top:1px solid #34403f;padding-block:25px;color:#8fa296;font-size:10px}footer p{font-size:11px}
  @media(min-width:1500px){.hero{padding-top:70px}}
  @media(max-width:1000px){.wrap{width:calc(100% - 48px)}.hero{gap:40px}.compact-card{grid-template-columns:95px minmax(0,1fr);gap:14px}.description{min-height:93px}.role{min-height:36px}.compact-card h4{font-size:14px}}
  @media(max-width:680px){.wrap{width:calc(100% - 36px)}.site-header{padding-block:20px}nav{gap:22px}.hero{grid-template-columns:1fr;padding-top:36px;gap:25px}h1{font-size:58px}.hero-aside{max-width:360px}.hero-aside p{font-size:16px}.hero-bottom{margin-top:5px;font-size:8px;gap:20px}.hero-bottom span:last-child{text-align:right}.selected{padding-top:28px}.section-heading{display:block}.section-heading>p{margin-top:13px}.selected-grid,.compact-grid{grid-template-columns:1fr;gap:24px}.project-content{padding:21px}.description,.role{min-height:0}.project-image .image-index{font-size:8px}.group-heading{display:block}.group-heading p{margin-top:5px}.compact-grid{gap:0}.compact-card{grid-template-columns:110px minmax(0,1fr)}.compact-card+.compact-card{border-top:0}.compact-card h4{font-size:16px}.about{grid-template-columns:1fr;gap:28px;padding-block:44px}.about h2{font-size:36px}.group-heading h3{font-size:19px}footer{flex-wrap:wrap}footer p{order:3;width:100%}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.project-card,.project-image img,.compact-image img{transition:none}}
</style>
